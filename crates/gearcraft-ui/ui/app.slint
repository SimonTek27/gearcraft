// GearCraft — Slint UI (dark, accent #00E7A0)

import { Button, VerticalBox, HorizontalBox, Slider, ScrollView } from "std-widgets.slint";

export struct DeviceRow {
    id: string,
    name: string,
    vendor: string,
    kind: string,
    online: bool,
    detail: string,
}

export struct ChannelRow {
    id: string,
    label: string,
    color: brush,
    volume: int,
    muted: bool,
    solo: bool,
    device: string,
}

export struct PresetRow {
    id: string,
    name: string,
    notes: string,
    eq-enabled: bool,
    auto: bool,
}

// Sidebar navigation entry: icon (passed as @children) + label
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 46px;
    border-radius: 10px;
    background: root.active ? #12332c : #1a1b1e;
    border-width: 1px;
    border-color: root.active ? #00e7a0 : #2a2b2f;

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        @children

        Text {
            text: root.label;
            color: root.active ? #00e7a0 : #e6e7e9;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component App inherits Window {


    title: "GearCraft";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: #0f1013;

    // ---- state (set from Rust) ----
    in-out property <int> page: 0; // 0 Engine, 1 Sonar
    in-out property <string> status-text: "Connecting…";
    in-out property <bool> daemon-online: false;
    in-out property <[DeviceRow]> devices: [];
    in-out property <string> selected-device-id: "";
    in-out property <string> selected-device-name: "—";
    in-out property <float> color-r: 0;
    in-out property <float> color-g: 0.906;
    in-out property <float> color-b: 0.627;
    in-out property <string> color-zone: "logo";
    in-out property <int> chatmix-balance: 0;
    in-out property <int> game-volume: 100;
    in-out property <int> chat-volume: 100;
    in-out property <string> chatmix-backend: "—";
    in-out property <bool> chatmix-ready: false;
    in-out property <bool> streamer-mode: true;
    in-out property <bool> sonar-enabled: true;
    in-out property <[PresetRow]> presets: [];
    in-out property <string> active-preset-id: "";
    in-out property <string> active-preset-name: "—";
    in-out property <string> preset-name-input: "";
    in-out property <[ChannelRow]> channels: [
        { id: "master", label: "MASTER", color: #8b8d91, volume: 100, muted: false, solo: false, device: "System" },
        { id: "game", label: "GAME", color: #00e7a0, volume: 100, muted: false, solo: false, device: "GearCraft_Game" },
        { id: "chat", label: "CHAT", color: #3b9eff, volume: 100, muted: false, solo: false, device: "GearCraft_Chat" },
        { id: "media", label: "MEDIA", color: #e84d8a, volume: 100, muted: false, solo: false, device: "Default" },
        { id: "aux", label: "AUX", color: #a78bfa, volume: 100, muted: false, solo: false, device: "Default" },
        { id: "mic", label: "MIC", color: #f5a524, volume: 100, muted: false, solo: false, device: "Input" },
    ];

    // ---- callbacks → Rust ----
    callback refresh-devices();
    callback select-device(string);
    callback apply-color();
    callback set-chatmix(int);
    callback setup-chatmix();
    callback channel-volume(string, int);
    callback channel-mute(string);
    callback channel-solo(string);
    callback toggle-streamer();
    callback toggle-sonar();
    callback refresh-presets();
    callback load-preset(string);
    callback save-preset(string);
    callback delete-preset(string);
    callback toggle-preset-rule(string);

    HorizontalBox {
        padding: 0;
        spacing: 0;

        // Sidebar
        Rectangle {
            width: 200px;
            background: #141518;

            VerticalBox {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "GearCraft";
                    color: #00e7a0;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.status-text;
                    color: root.daemon-online ? #00e7a0 : #8b8d91;
                    font-size: 11px;
                }

                Rectangle { height: 12px; background: transparent; }

                NavItem {
                    label: "Engine";
                    active: root.page == 0;
                    clicked => { root.page = 0; }

                    // Mixer / controls icon
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 0 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 2 6 H 22 M 2 12 H 22 M 2 18 H 22 M 8 3 V 9 M 16 9 V 15 M 6 15 V 21";
                    }
                }

                NavItem {
                    label: "Sonar";
                    active: root.page == 1;
                    clicked => { root.page = 1; }

                    // Headphones icon: headband + ear cups
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 1 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 4 15 V 12 A 8 8 0 0 1 20 12 V 15";
                    }
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: root.page == 1 ? #00e7a0 : #8b8d91;
                        stroke-width: 0px;
                        commands: "M 2 14 H 7 V 21 H 2 Z M 17 14 H 22 V 21 H 17 Z";
                    }
                }
            }
        }

        // Content
        Rectangle {
            background: #0f1013;

            // ENGINE
            if root.page == 0: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    spacing: 10px;

                    Text {
                        text: "Engine";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    // Manual rescan (the sidebar Refresh tab is gone)
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: refresh-touch.pressed ? #22242a : #1a1b1e;
                        border-width: 1px;
                        border-color: #2a2b2f;

                        Path {
                            width: 18px;
                            height: 18px;
                            x: 8px;
                            y: 8px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: transparent;
                            stroke: root.daemon-online ? #00e7a0 : #8b8d91;
                            stroke-width: 2px;
                            commands: "M 20 12 A 8 8 0 1 1 17.6 6.3 M 20 3 V 8 H 15";
                        }

                        refresh-touch := TouchArea {
                            clicked => { root.refresh-devices(); }
                        }
                    }
                }
                Text {
                    text: "RGB · selected: " + root.selected-device-name;
                    color: #8b8d91;
                    font-size: 12px;
                }

                // Device picker (was the Home tab)
                HorizontalBox {
                    spacing: 8px;

                    for dev in root.devices: Rectangle {
                        min-width: 160px;
                        height: 52px;
                        background: #1a1b1e;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: dev.id == root.selected-device-id ? #00e7a0 : #2a2b2f;

                        TouchArea {
                            clicked => { root.select-device(dev.id); }
                            HorizontalBox {
                                padding: 10px;
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: 6px;
                                    border-radius: 4px;
                                    background: dev.online ? #00e7a0 : #5a5b5f;
                                }
                                VerticalBox {
                                    spacing: 2px;
                                    Text {
                                        text: dev.name;
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: dev.vendor + " · " + dev.kind;
                                        color: #8b8d91;
                                        font-size: 10px;
                                    }
                                }
                            }
                        }
                    }
                    if root.devices.length == 0: Text {
                        text: "No devices (start gearcraft-daemon or plug hardware).";
                        color: #8b8d91;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                HorizontalBox {
                    spacing: 24px;

                    // Color preview
                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2a2b2f;
                        background: rgb(
                            root.color-r * 255,
                            root.color-g * 255,
                            root.color-b * 255
                        );
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Red"; color: #8b8d91; font-size: 11px; }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value: root.color-r;
                            changed(v) => { root.color-r = v; }
                        }
                        Text { text: "Green"; color: #8b8d91; font-size: 11px; }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value: root.color-g;
                            changed(v) => { root.color-g = v; }
                        }
                        Text { text: "Blue"; color: #8b8d91; font-size: 11px; }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value: root.color-b;
                            changed(v) => { root.color-b = v; }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Button {
                                text: "Logo";
                                primary: root.color-zone == "logo";
                                clicked => { root.color-zone = "logo"; }
                            }
                            Button {
                                text: "All";
                                primary: root.color-zone == "all";
                                clicked => { root.color-zone = "all"; }
                            }
                            Button {
                                text: "Apply colour";
                                primary: true;
                                clicked => { root.apply-color(); }
                            }
                        }
                    }
                }
            }

            // SONAR — mixer always visible; streamer mode adds dual path above the fader
            if root.page == 1: VerticalBox {
                padding: 16px;
                spacing: 10px;

                HorizontalBox {
                    Text {
                        text: "Sonar";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.streamer-mode ? "  ·  Modalità streamer" : "";
                        color: #8b8d91;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.chatmix-backend + (root.chatmix-ready ? " · ready" : " · not linked");
                        color: root.chatmix-ready ? #00e7a0 : #8b8d91;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: root.streamer-mode ? "Streamer: ON" : "Streamer: OFF";
                        primary: root.streamer-mode;
                        clicked => { root.toggle-streamer(); }
                    }
                    Button {
                        text: root.sonar-enabled ? "Spegni Sonar" : "Accendi Sonar";
                        clicked => { root.toggle-sonar(); }
                    }
                    Button {
                        text: "Setup sinks";
                        clicked => { root.setup-chatmix(); }
                    }
                }

                // Multi-channel mixer
                HorizontalBox {
                    spacing: 8px;
                    vertical-stretch: 1;

                    for ch in root.channels: Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2a2b2f;
                        background: #1a1b1e;
                        opacity: root.sonar-enabled ? 1.0 : 0.45;
                        min-width: 120px;

                        VerticalBox {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Header: name + settings
                            HorizontalBox {
                                spacing: 4px;
                                Text {
                                    text: ch.label;
                                    color: ch.color;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    width: 22px;
                                    height: 22px;
                                    Rectangle {
                                        border-radius: 6px;
                                        background: parent.has-hover ? #2a2b2f : transparent;
                                        Text {
                                            text: "⚙";
                                            color: #8b8d91;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Device model + circular volume %
                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: ch.device;
                                    color: #8b8d91;
                                    font-size: 10px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                // Progress ring (track + arc) + % in center
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    background: transparent;

                                    // Track
                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: #2a2b2f;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        MoveTo {
                                            x: 50;
                                            y: 50 - 40;
                                        }
                                        ArcTo {
                                            radius-x: 40;
                                            radius-y: 40;
                                            x: 49.99;
                                            y: 50 - 40;
                                            large-arc: true;
                                            sweep: true;
                                        }
                                    }
                                    // Progress arc (0–100%)
                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: ch.muted ? #5a5b5f : ch.color;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        private property <float> p: Math.min(0.9999, ch.volume / 100);
                                        private property <float> r: 40;
                                        private property <float> cx: 50;
                                        private property <float> cy: 50;
                                        MoveTo {
                                            x: cx;
                                            y: cy - r;
                                        }
                                        ArcTo {
                                            radius-x: r;
                                            radius-y: r;
                                            x: cx + r * Math.sin(p * 360deg);
                                            y: cy - r * Math.cos(p * 360deg);
                                            sweep: p > 0;
                                            large-arc: p > 0.5;
                                        }
                                    }
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: ch.volume + "%";
                                        color: #ffffff;
                                        font-size: 8px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Streamer dual meters
                            if root.streamer-mode: HorizontalBox {
                                spacing: 12px;
                                alignment: center;
                                height: 90px;
                                VerticalBox {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: "🎧"; font-size: 11px; horizontal-alignment: center; }
                                    Rectangle {
                                        width: 14px;
                                        vertical-stretch: 1;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : ch.color;
                                        }
                                    }
                                }
                                VerticalBox {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: "📡"; font-size: 11px; horizontal-alignment: center; }
                                    Rectangle {
                                        width: 14px;
                                        vertical-stretch: 1;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : ch.color;
                                        }
                                    }
                                }
                            }

                            // Vertical fader (real cursor)
                            Rectangle {
                                height: 160px;
                                horizontal-stretch: 1;

                                Rectangle {
                                    width: 6px;
                                    height: parent.height - 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: 8px;
                                    border-radius: 3px;
                                    background: #0f1013;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * (ch.volume / 100.0);
                                        y: parent.height - self.height;
                                        border-radius: 3px;
                                        background: ch.muted ? #3a3b3f : ch.color;
                                        opacity: 0.4;
                                    }
                                }

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: root.sonar-enabled;
                                    moved => {
                                        if (self.pressed) {
                                            root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                        }
                                    }
                                    clicked => {
                                        root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                    }
                                    Rectangle {
                                        width: 22px;
                                        height: 14px;
                                        x: (parent.width - self.width) / 2;
                                        y: (1.0 - ch.volume / 100.0) * (parent.height - self.height);
                                        border-radius: 4px;
                                        background: #f0f0f2;
                                        border-width: 1px;
                                        border-color: #ffffff;
                                        VerticalBox {
                                            padding: 3px;
                                            spacing: 2px;
                                            alignment: center;
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: ch.muted ? "-inf dB" : (ch.volume >= 100 ? "0 dB" : "-" + (Math.round((100 - ch.volume) * 0.2)) + " dB");
                                color: #8b8d91;
                                font-size: 10px;
                                font-family: "monospace";
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2a2b2f;
                                background: #121316;
                                HorizontalBox {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    Text { text: "App"; color: #5a5b5f; font-size: 10px; vertical-alignment: center; }
                                    Text {
                                        text: ch.device;
                                        color: #8b8d91;
                                        font-size: 10px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text { text: ">"; color: #5a5b5f; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                Button {
                                    text: "M";
                                    primary: ch.muted;
                                    clicked => { root.channel-mute(ch.id); }
                                }
                                Button {
                                    text: "S";
                                    primary: ch.solo;
                                    clicked => { root.channel-solo(ch.id); }
                                }
                            }
                        }
                    }
                }

                // Audio presets (JDSP4Linux-style)
                Rectangle {
                    height: 200px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;

                    VerticalBox {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;

                        HorizontalBox {
                            Text {
                                text: "PRESET AUDIO";
                                color: #8b8d91;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: "  attivo: " + root.active-preset-name;
                                color: #00e7a0;
                                font-size: 11px;
                            }
                            Text {
                                text: root.selected-device-name == "—" ? "" : "  ·  regola su: " + root.selected-device-name;
                                color: #8b8d91;
                                font-size: 11px;
                                width: 160px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                text: "Aggiorna";
                                clicked => { root.refresh-presets(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            vertical-stretch: 1;

                            ScrollView {
                                horizontal-stretch: 1;
                                VerticalBox {
                                    spacing: 4px;
                                    for p in root.presets: HorizontalBox {
                                        spacing: 8px;
                                        Text {
                                            text: p.name + (p.eq-enabled ? "  · EQ" : "");
                                            color: p.id == root.active-preset-id ? #00e7a0 : #ffffff;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: p.notes;
                                            color: #5a5b5f;
                                            font-size: 10px;
                                            overflow: elide;
                                            width: 180px;
                                            vertical-alignment: center;
                                        }
                                        Button {
                                            text: p.auto ? "Auto ✓" : "Auto";
                                            primary: p.auto;
                                            clicked => { root.toggle-preset-rule(p.id); }
                                        }
                                        Button {
                                            text: "Carica";
                                            primary: p.id == root.active-preset-id;
                                            clicked => { root.load-preset(p.id); }
                                        }
                                        Button {
                                            text: "Elimina";
                                            clicked => { root.delete-preset(p.id); }
                                        }
                                    }
                                }
                            }

                            VerticalBox {
                                width: 200px;
                                spacing: 6px;
                                Text {
                                    text: "Salva preset corrente";
                                    color: #8b8d91;
                                    font-size: 10px;
                                }
                                // Slint 1.6: use LineEdit if available; fallback Button with fixed names
                                Button {
                                    text: "Salva come «Custom»";
                                    clicked => {
                                        root.save-preset("Custom");
                                    }
                                }
                                Button {
                                    text: "Salva come «Session»";
                                    clicked => {
                                        root.save-preset("Session");
                                    }
                                }
                                Text {
                                    text: "Include ChatMix attuale";
                                    color: #5a5b5f;
                                    font-size: 9px;
                                }
                            }
                        }
                    }
                }

                // ChatMix bar (always)
                Rectangle {
                    height: 72px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    opacity: root.sonar-enabled ? 1.0 : 0.45;

                    VerticalBox {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 4px;

                        HorizontalBox {
                            Text {
                                text: "CHATMIX";
                                color: #8b8d91;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.chatmix-balance;
                                color: #ffffff;
                                font-size: 11px;
                                font-family: "monospace";
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Game"; color: #00e7a0; font-size: 11px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: -100;
                                maximum: 100;
                                value: root.chatmix-balance;
                                enabled: root.sonar-enabled;
                                changed(v) => { root.set-chatmix(v); }
                            }
                            Text { text: "Chat"; color: #3b9eff; font-size: 11px; vertical-alignment: center; }
                        }
                        HorizontalBox {
                            Text {
                                text: "Game " + root.game-volume + "%";
                                color: #8b8d91;
                                font-size: 10px;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: "Chat " + root.chat-volume + "%";
                                color: #8b8d91;
                                font-size: 10px;
                            }
                        }
                    }
                }
            }
        }
    }
}
