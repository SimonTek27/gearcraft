// GearCraft — Slint UI (dark, accent #00E7A0)

import { VerticalBox, HorizontalBox, Slider, ScrollView } from "std-widgets.slint";

export struct DeviceRow {
    id: string,
    name: string,
    vendor: string,
    kind: string,
    online: bool,
    detail: string,
}

export struct ChannelRow {
    id: string,
    label: string,
    color: brush,
    volume: int,
    muted: bool,
    solo: bool,
    device: string,
    device-volume: int,
    preset-name: string,
    preset-on: bool,
    apps: string,
    pan: int,
    streamer-volume: int,
}

export struct PresetRow {
    id: string,
    name: string,
    notes: string,
    eq-enabled: bool,
    auto: bool,
}

export struct OutputDeviceRow {
    id: string,
    label: string,
    is-virtual: bool,
    available: bool,
}

export struct EqBandRow {
    index: int,
    freq-label: string,
    gain: float,
}

export struct CameraDeviceRow {
    id: string,
    label: string,
    path: string,
    available: bool,
}

export struct CameraEffectRow {
    id: string,
    name: string,
    kind: string,
    enabled: bool,
    intensity: int,
}

// Sidebar navigation entry: icon (passed as @children) + label
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 46px;
    border-radius: 10px;
    background: root.active ? #12332c : #1a1b1e;
    border-width: 1px;
    border-color: root.active ? #00e7a0 : #2a2b2f;

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        vertical-stretch: 0;

        Rectangle {
            width: 18px;
            height: 18px;

            @children
        }

        Text {
            text: root.label;
            color: root.active ? #00e7a0 : #e6e7e9;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Backlit console key button
component ConsoleButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    min-width: 44px;
    border-radius: 8px;
    background: root.primary
        ? (root.pressed ? #0a2a22 : #0d1f1a)
        : (root.pressed ? #141518 : #1a1b1e);
    border-width: 1px;
    border-color: root.primary
        ? (root.has-hover ? #00e7a0 : #00e7a080)
        : (root.has-hover ? #3a3b3f : #2a2b2f);
    opacity: root.enabled ? 1.0 : 0.45;

    // backlight glow
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: transparent;
        border-width: 0px;
        // glow layer
        Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: parent.border-radius - 2px;
            background: root.primary ? #00e7a018 : (root.has-hover ? #ffffff08 : transparent);
        }
    }

    Text {
        text: root.text;
        color: root.primary ? #00e7a0 : (root.has-hover ? #ffffff : #c8c9cc);
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%; height: 100%;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    property <bool> pressed: ta.pressed;
    property <bool> has-hover: ta.has-hover;
}

// Android-style toggle switch
component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <string> label: "";
    callback toggled();

    width: 52px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? #00e7a0 : #2a2b2f;
    border-width: 1px;
    border-color: root.checked ? #00e7a0 : #3a3b3f;

    // thumb
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        y: 2px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: #ffffff;
        // subtle shadow
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

export component App inherits Window {
    title: "GearCraft";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: #0f1013;

    // ---- state (set from Rust) ----
    in-out property <int> page: 0; // 0 Engine, 1 Sonar, 2 Prism, 3 Camera
    in-out property <string> status-text: "Connecting…";
    in-out property <bool> daemon-online: false;
    in-out property <[DeviceRow]> devices: [];
    in-out property <string> selected-device-id: "";
    in-out property <string> selected-device-name: "—";
    in-out property <float> color-r: 0;
    in-out property <float> color-g: 0.906;
    in-out property <float> color-b: 0.627;
    in-out property <string> color-zone: "logo";
    in-out property <string> prism-effect: "static";
    // Screen capture (Spectacle GUI)
    in-out property <string> capture-mode: "full";
    in-out property <int> capture-delay: 0;
    in-out property <bool> capture-clipboard: true;
    in-out property <string> capture-last-path: "—";
    in-out property <string> capture-status: "Pronto";
    in-out property <int> mouse-dpi: 800;
    in-out property <string> mouse-dpi-label: "DPI: —";
    in-out property <int> chatmix-balance: 0;
    in-out property <int> game-volume: 100;
    in-out property <int> chat-volume: 100;
    in-out property <string> chatmix-backend: "—";
    in-out property <bool> chatmix-ready: false;
    in-out property <bool> streamer-mode: false;
    in-out property <string> fx-channel: "";
    in-out property <bool> sonar-enabled: true;
    in-out property <[PresetRow]> presets: [];
    in-out property <string> active-preset-id: "";
    in-out property <string> active-preset-name: "—";
    in-out property <string> preset-name-input: "";
    in-out property <[OutputDeviceRow]> output-devices: [];
    in-out property <string> selected-output-id: "";
    in-out property <string> selected-output-label: "—";
    in-out property <bool> link-all-devices: true;
    in-out property <string> ch-device-game: "—";
    in-out property <string> ch-device-chat: "—";
    in-out property <string> ch-device-media: "—";
    in-out property <string> ch-device-aux: "—";
    in-out property <string> backup-mode-label: "automatic";
    in-out property <bool> spatial-enabled: true;
    in-out property <int> spatial-immersion: 40;
    in-out property <int> spatial-distance: 40;
    in-out property <int> volume-boost: 0;
    in-out property <bool> smart-volume: false;
    in-out property <bool> eq-enabled: true;
    in-out property <int> mic-gain: 100;
    in-out property <bool> mic-muted: false;
    in-out property <bool> mic-highpass: true;
    in-out property <bool> mic-noise-gate: false;
    in-out property <int> mic-gate-strength: 40;
    in-out property <bool> mic-lowpass: false;
    in-out property <bool> mic-compressor: false;
    in-out property <[EqBandRow]> eq-bands: [
        { index: 0, freq-label: "31", gain: 0 },
        { index: 1, freq-label: "63", gain: 0 },
        { index: 2, freq-label: "125", gain: 0 },
        { index: 3, freq-label: "250", gain: 0 },
        { index: 4, freq-label: "500", gain: 0 },
        { index: 5, freq-label: "1k", gain: 0 },
        { index: 6, freq-label: "2k", gain: 0 },
        { index: 7, freq-label: "4k", gain: 0 },
        { index: 8, freq-label: "8k", gain: 0 },
        { index: 9, freq-label: "16k", gain: 0 },
    ];
    in-out property <[ChannelRow]> channels: [
        { id: "master", label: "MASTER", color: #8b8d91, volume: 100, muted: false, solo: false, device: "System", device-volume: 100, preset-name: "Default", preset-on: true, apps: "System sounds", pan: 0, streamer-volume: 100 },
        { id: "game", label: "GAME", color: #00e7a0, volume: 100, muted: false, solo: false, device: "GearCraft_Game", device-volume: 100, preset-name: "Game", preset-on: true, apps: "", pan: 0, streamer-volume: 100 },
        { id: "chat", label: "CHAT", color: #3b9eff, volume: 100, muted: false, solo: false, device: "GearCraft_Chat", device-volume: 100, preset-name: "Chat", preset-on: true, apps: "", pan: 0, streamer-volume: 100 },
        { id: "media", label: "MEDIA", color: #e84d8a, volume: 100, muted: false, solo: false, device: "Default", device-volume: 100, preset-name: "Media", preset-on: true, apps: "", pan: 0, streamer-volume: 100 },
        { id: "aux", label: "AUX", color: #a78bfa, volume: 100, muted: false, solo: false, device: "Default", device-volume: 100, preset-name: "Aux", preset-on: true, apps: "", pan: 0, streamer-volume: 100 },
        { id: "mic", label: "MIC", color: #f5a524, volume: 100, muted: false, solo: false, device: "Input", device-volume: 100, preset-name: "Mic", preset-on: true, apps: "", pan: 0, streamer-volume: 100 },
    ];

    // Camera (under Sonar)
    in-out property <[CameraDeviceRow]> camera-devices: [];
    in-out property <string> camera-device-id: "";
    in-out property <string> camera-device-label: "Nessuna camera";
    in-out property <bool> camera-preview-active: false;
    in-out property <image> camera-frame;
    in-out property <string> camera-preview-status: "Preview spenta";
    in-out property <string> camera-mode: "video"; // video | photo
    // Video capture
    in-out property <string> cam-video-resolution: "1280x720";
    in-out property <int> cam-video-fps: 30;
    in-out property <string> cam-video-format: "MJPG";
    in-out property <int> cam-video-bitrate: 8; // Mbps
    in-out property <bool> cam-video-recording: false;
    // Photo
    in-out property <string> cam-photo-resolution: "1920x1080";
    in-out property <string> cam-photo-format: "JPEG";
    in-out property <int> cam-photo-quality: 90;
    in-out property <int> cam-photo-timer: 0; // seconds
    // Image controls
    in-out property <int> cam-brightness: 50;
    in-out property <int> cam-contrast: 50;
    in-out property <int> cam-saturation: 50;
    in-out property <int> cam-sharpness: 50;
    in-out property <int> cam-exposure: 50;
    in-out property <bool> cam-auto-exposure: true;
    in-out property <bool> cam-auto-wb: true;
    in-out property <int> cam-wb-temp: 4500;
    // Effects
    in-out property <[CameraEffectRow]> camera-effects: [];
    in-out property <string> camera-effect-name-input: "";

    // ---- callbacks → Rust ----

    callback refresh-devices();
    callback select-device(string);
    callback apply-color();
    callback take-screenshot(string);
    callback start-capture();
    callback set-capture-mode(string);
    callback set-capture-delay(int);
    callback toggle-capture-clipboard();
    callback open-prism(string);
    callback apply-prism();
    callback prism-sync-all();
    callback set-device-dpi(int);
    callback refresh-mouse-info();
    callback set-prism-effect(string);
    callback set-chatmix(int);
    callback setup-chatmix();
    callback channel-volume(string, int);
    callback channel-mute(string);
    callback channel-solo(string);
    callback channel-pan(string, int);
    callback channel-streamer-volume(string, int);
    callback toggle-streamer();
    callback toggle-sonar();
    callback refresh-presets();
    callback load-preset(string);
    callback save-preset(string);
    callback delete-preset(string);
    callback refresh-device-manager();
    callback select-output-device(string);
    callback assign-channel-device(string);
    callback link-all-outputs();
    callback apply-device-manager();
    callback apply-spatial();
    callback set-spatial-immersion(int);
    callback set-spatial-distance(int);
    callback set-volume-boost(int);
    callback toggle-smart-volume();
    callback toggle-spatial();
    callback toggle-eq();
    callback eq-band-gain(int, float);
    callback reset-eq();
    callback apply-eq();
    callback reset-spatial();
    callback reset-all-fx();
    callback set-mic-gain(int);
    callback toggle-mic-mute();
    callback toggle-mic-highpass();
    callback toggle-mic-gate();
    callback apply-mic-fx();
    callback refresh-mic-fx();
    callback refresh-cameras();
    callback select-camera(string);
    callback toggle-camera-preview();
    callback set-camera-mode(string);
    callback set-cam-video-resolution(string);
    callback set-cam-video-fps(int);
    callback set-cam-video-format(string);
    callback set-cam-video-bitrate(int);
    callback toggle-cam-recording();
    callback set-cam-photo-resolution(string);
    callback set-cam-photo-format(string);
    callback set-cam-photo-quality(int);
    callback set-cam-photo-timer(int);
    callback capture-photo();
    callback set-cam-brightness(int);
    callback set-cam-contrast(int);
    callback set-cam-saturation(int);
    callback set-cam-sharpness(int);
    callback set-cam-exposure(int);
    callback toggle-cam-auto-exposure();
    callback toggle-cam-auto-wb();
    callback set-cam-wb-temp(int);
    callback toggle-camera-effect(string);
    callback set-camera-effect-intensity(string, int);
    callback add-camera-effect(string);
    callback remove-camera-effect(string);
    callback apply-camera-settings();

    callback toggle-mic-lowpass();
    callback toggle-mic-compressor();
    callback toggle-preset-rule(string);
    callback toggle-channel-preset(string);

    // Custom window chrome
    in-out property <bool> win-maximized: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-help: false;
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback open-settings();
    callback open-help();

    // Navigation history
    callback go(int);
    callback nav-back();
    callback nav-forward();
    callback nav-refresh();

    Rectangle {
        // Root chrome container (CSD + content + overlays)

        VerticalBox {
        padding: 0;
        spacing: 0;
        x: 0; y: 0;
        width: 100%;
        height: 100%;

        // ---- Custom title bar (themed CSD) ----
        Rectangle {
            height: 40px;
            background: #0a0b0d;
            border-width: 0px;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                alignment: stretch;

                // App mark + title (drag region)
                HorizontalBox {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    alignment: start;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: 6px;
                        border-radius: 3px;
                        background: #00e7a0;
                    }
                    Text {
                        text: "GearCraft";
                        color: #e6e7e9;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.status-text;
                        color: root.daemon-online ? #00e7a0 : #5a5b5f;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                // Nav toolbar (KDE-like icons: home, back, forward, refresh)
                Rectangle {
                    width: 26px; height: 26px; y: 2px;
                    border-radius: 6px;
                    background: #1a1b1e; border-width: 1px; border-color: #2a2b2f;
                    Path {
                        width: 16px; height: 16px; x: 5px; y: 5px;
                        viewbox-width: 24; viewbox-height: 24;
                        fill: transparent;
                        stroke: #8b8d91; stroke-width: 2px;
                        commands: "M 4 11 L 12 4 L 20 11 M 6 10 V 19 H 18 V 10";
                    }
                    TouchArea { clicked => { root.go(1); } }
                }
                Rectangle {
                    width: 26px; height: 26px; y: 2px;
                    border-radius: 6px;
                    Path {
                        width: 16px; height: 16px; x: 5px; y: 5px;
                        viewbox-width: 24; viewbox-height: 24;
                        fill: transparent;
                        stroke: #8b8d91; stroke-width: 2px;
                        commands: "M 20 4 L 6 12 L 20 20";
                    }
                    TouchArea { clicked => { root.nav-back(); } }
                }
                Rectangle {
                    width: 26px; height: 26px; y: 2px;
                    border-radius: 6px;
                    Path {
                        width: 16px; height: 16px; x: 5px; y: 5px;
                        viewbox-width: 24; viewbox-height: 24;
                        fill: transparent;
                        stroke: #8b8d91; stroke-width: 2px;
                        commands: "M 4 4 L 18 12 L 4 20";
                    }
                    TouchArea { clicked => { root.nav-forward(); } }
                }
                Rectangle {
                    width: 26px; height: 26px; y: 2px;
                    border-radius: 6px;
                    Path {
                        width: 16px; height: 16px; x: 5px; y: 5px;
                        viewbox-width: 24; viewbox-height: 24;
                        fill: transparent;
                        stroke: #8b8d91; stroke-width: 2px;
                        commands: "M 20 12 A 8 8 0 1 1 17.6 6.3 M 20 3 V 8 H 15";
                    }
                    TouchArea { clicked => { root.nav-refresh(); } }
                }

                // Settings + Help
                Rectangle {
                    width: 32px;
                    height: 28px;
                    y: 2px;
                    border-radius: 6px;
                    background: root.show-settings ? #12332c : transparent;
                    border-width: 1px;
                    border-color: root.show-settings ? #00e7a0 : transparent;

                    Text {
                        text: "⚙";
                        color: root.show-settings ? #00e7a0 : #8b8d91;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => { root.open-settings(); }
                    }
                }
                Rectangle {
                    width: 32px;
                    height: 28px;
                    y: 2px;
                    border-radius: 6px;
                    background: root.show-help ? #12332c : transparent;
                    border-width: 1px;
                    border-color: root.show-help ? #00e7a0 : transparent;

                    Text {
                        text: "?";
                        color: root.show-help ? #00e7a0 : #8b8d91;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => { root.open-help(); }
                    }
                }

                // Window controls
                Rectangle {
                    width: 36px;
                    height: 28px;
                    y: 2px;
                    border-radius: 6px;
                    background: transparent;
                    Text {
                        text: "—";
                        color: #8b8d91;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => { root.win-minimize(); }
                    }
                }
                Rectangle {
                    width: 36px;
                    height: 28px;
                    y: 2px;
                    border-radius: 6px;
                    background: transparent;
                    Text {
                        text: root.win-maximized ? "❐" : "□";
                        color: #8b8d91;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => { root.win-maximize(); }
                    }
                }
                Rectangle {
                    width: 36px;
                    height: 28px;
                    y: 2px;
                    border-radius: 6px;
                    background: transparent;
                    Text {
                        text: "✕";
                        color: #8b8d91;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    TouchArea {
                        clicked => { root.win-close(); }
                    }
                }
            }
        }

        HorizontalBox {
            padding: 0;
            spacing: 0;
            vertical-stretch: 1;

        // Sidebar
        Rectangle {
            width: 200px;
            background: #141518;

            VerticalBox {
                padding: 16px;
                spacing: 8px;

                NavItem {
                    label: "Engine";
                    active: root.page == 0;
                    clicked => { root.go(0); }

                    // Mixer / controls icon
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 0 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 2 6 H 22 M 2 12 H 22 M 2 18 H 22 M 8 3 V 9 M 16 9 V 15 M 6 15 V 21";
                    }
                }

                NavItem {
                    label: "Sonar";
                    active: root.page == 1 || root.page == 5;
                    clicked => { root.go(1); }

                    // Headphones icon: headband + ear cups
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 1 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 4 15 V 12 A 8 8 0 0 1 20 12 V 15";
                    }
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: root.page == 1 ? #00e7a0 : #8b8d91;
                        stroke-width: 0px;
                        commands: "M 2 14 H 7 V 21 H 2 Z M 17 14 H 22 V 21 H 17 Z";
                    }
                }

                NavItem {
                    label: "Camera";
                    active: root.page == 3;
                    clicked => { root.go(3); root.refresh-cameras(); }

                    // Camera icon
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 3 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 4 7 H 15 V 17 H 4 Z M 15 10 L 20 7 V 17 L 15 14 Z";
                    }
                }

                NavItem {
                    label: "Prism";
                    active: root.page == 2;
                    clicked => { root.go(2); }

                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: root.page == 2 ? #00e7a0 : #8b8d91;
                        stroke-width: 0px;
                        commands: "M 12 2 L 22 8 L 22 16 L 12 22 L 2 16 L 2 8 Z";
                    }
                }
                NavItem {
                    label: "Schermo";
                    active: root.page == 4;
                    clicked => { root.go(4); }

                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: transparent;
                        stroke: root.page == 4 ? #00e7a0 : #8b8d91;
                        stroke-width: 2px;
                        commands: "M 3 5 H 21 V 16 H 3 Z M 8 19 H 16 M 12 16 V 19";
                    }
                }

            }
        }

        // Content
        Rectangle {
            background: #0f1013;

            // ENGINE
            if root.page == 0: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    spacing: 10px;

                    Text {
                        text: "Engine";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    // Manual rescan (the sidebar Refresh tab is gone)
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: refresh-touch.pressed ? #22242a : #1a1b1e;
                        border-width: 1px;
                        border-color: #2a2b2f;

                        Path {
                            width: 18px;
                            height: 18px;
                            x: 8px;
                            y: 8px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: transparent;
                            stroke: root.daemon-online ? #00e7a0 : #8b8d91;
                            stroke-width: 2px;
                            commands: "M 20 12 A 8 8 0 1 1 17.6 6.3 M 20 3 V 8 H 15";
                        }

                        refresh-touch := TouchArea {
                            clicked => { root.refresh-devices(); }
                        }
                    }
                }
                Text {
                    text: "RGB · selected: " + root.selected-device-name;
                    color: #8b8d91;
                    font-size: 12px;
                }

                // Device picker (was the Home tab)
                HorizontalBox {
                    spacing: 8px;

                    for dev in root.devices: Rectangle {
                        min-width: 160px;
                        height: 52px;
                        background: #1a1b1e;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: dev.id == root.selected-device-id ? #00e7a0 : #2a2b2f;

                        TouchArea {
                            clicked => { root.select-device(dev.id); root.go(2); }
                            HorizontalBox {
                                padding: 10px;
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: 6px;
                                    border-radius: 4px;
                                    background: dev.online ? #00e7a0 : #5a5b5f;
                                }
                                VerticalBox {
                                    spacing: 2px;
                                    Text {
                                        text: dev.name;
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: dev.vendor + " · " + dev.kind;
                                        color: #8b8d91;
                                        font-size: 10px;
                                    }
                                }
                            }
                        }
                    }
                    if root.devices.length == 0: Text {
                        text: "No devices (start gearcraft-daemon or plug hardware).";
                        color: #8b8d91;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Seleziona un device per aprire le proprietà (RGB, DPI, cattura).";
                    color: #8b8d91;
                    font-size: 12px;
                }

                HorizontalBox {
                    spacing: 8px;
                    ConsoleButton {
                        text: "📸  Cattura schermo";
                        clicked => { root.go(4); }
                    }
                    ConsoleButton {
                        text: "Prism (RGB)";
                        clicked => { if (root.selected-device-id != "") { root.go(2); } }
                    }
                }

            }

            // SONAR — mixer always visible; streamer mode adds dual path above the fader
            if root.page == 1: VerticalBox {
                padding: 16px;
                spacing: 10px;

                HorizontalBox {
                    Text {
                        text: "Sonar";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.streamer-mode ? "  ·  Modalità streamer" : "";
                        color: #8b8d91;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.chatmix-backend + (root.chatmix-ready ? " · ready" : " · not linked");
                        color: root.chatmix-ready ? #00e7a0 : #8b8d91;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Streamer";
                            color: #8b8d91;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ToggleSwitch {
                            checked: root.streamer-mode;
                            toggled => { root.toggle-streamer(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Sonar";
                            color: #8b8d91;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ToggleSwitch {
                            checked: root.sonar-enabled;
                            toggled => { root.toggle-sonar(); }
                        }
                    }
                    ConsoleButton {
                        text: "Setup sinks";
                        clicked => { root.setup-chatmix(); }
                    }
                }

                // Channel selector row: Mixer | Game | Chat | Media | Aux | Mic
                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    ConsoleButton {
                        text: "🎚  Mixer";
                        primary: root.page == 1;
                        clicked => { root.go(1); }
                    }
                    ConsoleButton {
                        text: "🎮  Game";
                        primary: root.page == 5 && root.fx-channel == "game";
                        clicked => { root.fx-channel = "game"; root.go(5); }
                    }
                    ConsoleButton {
                        text: "💬  Chat";
                        primary: root.page == 5 && root.fx-channel == "chat";
                        clicked => { root.fx-channel = "chat"; root.go(5); }
                    }
                    ConsoleButton {
                        text: "🎵  Media";
                        primary: root.page == 5 && root.fx-channel == "media";
                        clicked => { root.fx-channel = "media"; root.go(5); }
                    }
                    ConsoleButton {
                        text: "🔌  Aux";
                        primary: root.page == 5 && root.fx-channel == "aux";
                        clicked => { root.fx-channel = "aux"; root.go(5); }
                    }
                    ConsoleButton {
                        text: "🎤  Mic";
                        primary: root.page == 5 && root.fx-channel == "mic";
                        clicked => { root.fx-channel = "mic"; root.go(5); }
                    }
                }

                // Multi-channel mixer (fixed size, does not stretch on resize)
                HorizontalBox {
                    spacing: 8px;
                    alignment: start;
                    // 6 canali x 132px + 5 gap x 8px = 832px
                    width: 832px;

                    for ch in root.channels: Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2a2b2f;
                        background: #1a1b1e;
                        opacity: root.sonar-enabled ? 1.0 : 0.45;
                        width: 132px;

                        VerticalBox {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Header: icon + channel name (tinted strip)
                            Rectangle {
                                height: 30px;
                                border-radius: 8px;
                                background: #121316;
                                // subtle tint of the channel colour
                                Rectangle {
                                    x: 0; y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: ch.color;
                                    opacity: 0.10;
                                }
                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: ch.id == "master" ? "🔊" : ch.id == "game" ? "🎮" : ch.id == "chat" ? "💬" : ch.id == "media" ? "🎵" : ch.id == "aux" ? "🔌" : ch.id == "mic" ? "🎤" : "🔊";
                                        color: ch.color;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: ch.label;
                                        color: ch.color;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Preset name (above device volume) + on/off
                            HorizontalBox {
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 22px;
                                    border-radius: 6px;
                                    background: #121316;
                                    border-width: 1px;
                                    border-color: #2a2b2f;
                                    TouchArea {
                                        clicked => { root.active-preset-name = ch.preset-name; root.go(5); }
                                        Text {
                                            text: ch.preset-name;
                                            color: #00e7a0;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                            overflow: elide;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 30px;
                                    height: 22px;
                                    border-radius: 6px;
                                    background: ch.preset-on ? #12332c : #121316;
                                    border-width: 1px;
                                    border-color: ch.preset-on ? #00e7a0 : #2a2b2f;
                                    TouchArea {
                                        clicked => { root.toggle-channel-preset(ch.id); }
                                        Text {
                                            text: ch.preset-on ? "ON" : "OFF";
                                            color: ch.preset-on ? #00e7a0 : #8b8d91;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                }
                            }

                            // Device volume: "100" + device name + lock
                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                // Progress ring (device volume) + % in center
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    background: transparent;

                                    // Track
                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: #2a2b2f;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        MoveTo { x: 50; y: 50 - 40; }
                                        ArcTo {
                                            radius-x: 40;
                                            radius-y: 40;
                                            x: 49.99;
                                            y: 50 - 40;
                                            large-arc: true;
                                            sweep: true;
                                        }
                                    }
                                    // Progress arc
                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: ch.muted ? #5a5b5f : ch.color;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        private property <float> p: Math.min(0.9999, ch.device-volume / 100);
                                        private property <float> r: 40;
                                        private property <float> cx: 50;
                                        private property <float> cy: 50;
                                        MoveTo { x: cx; y: cy - r; }
                                        ArcTo {
                                            radius-x: r;
                                            radius-y: r;
                                            x: cx + r * Math.sin(p * 360deg);
                                            y: cy - r * Math.cos(p * 360deg);
                                            sweep: p > 0;
                                            large-arc: p > 0.5;
                                        }
                                    }
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: ch.device-volume + "%";
                                        color: #ffffff;
                                        font-size: 8px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: ch.device;
                                    color: #8b8d91;
                                    font-size: 9px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    TouchArea {
                                        clicked => { root.link-all-outputs(); }
                                        Text {
                                            text: root.link-all-devices ? "🔒" : "🔓";
                                            color: root.link-all-devices ? #00e7a0 : #5a5b5f;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                }
                            }

                            // Faders. Official logic: left = PERSONAL, right = STREAM,
                            // same signal, separate levels.
                            if root.streamer-mode: HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: "🎧 Personal";
                                    color: #8b8d91;
                                    font-size: 8px;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "📡 Stream";
                                    color: #ff6b6b;
                                    font-size: 8px;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalBox {
                                spacing: 6px;
                                alignment: stretch;

                                // Left fader: output (sempre presente)
                                Rectangle {
                                    height: 120px;
                                    horizontal-stretch: 1;

                                    Rectangle {
                                        width: 6px;
                                        height: parent.height - 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: 8px;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : ch.color;
                                            opacity: 0.4;
                                        }
                                    }

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        enabled: root.sonar-enabled;
                                        moved => {
                                            if (self.pressed) {
                                                root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                            }
                                        }
                                        clicked => {
                                            root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                        }
                                        Rectangle {
                                            width: 22px;
                                            height: 14px;
                                            x: (parent.width - self.width) / 2;
                                            y: (1.0 - ch.volume / 100.0) * (parent.height - self.height);
                                            border-radius: 4px;
                                            background: #f0f0f2;
                                            border-width: 1px;
                                            border-color: #ffffff;
                                        }
                                    }
                                }

                                // Right fader: STREAM mix (utile in streamer-mode)
                                if root.streamer-mode: Rectangle {
                                    height: 120px;
                                    horizontal-stretch: 1;

                                    Rectangle {
                                        width: 6px;
                                        height: parent.height - 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: 8px;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.streamer-volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : #ff6b6b;
                                            opacity: 0.4;
                                        }
                                    }

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        enabled: root.sonar-enabled;
                                        moved => {
                                            if (self.pressed) {
                                                root.channel-streamer-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                            }
                                        }
                                        clicked => {
                                            root.channel-streamer-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                        }
                                        Rectangle {
                                            width: 22px;
                                            height: 14px;
                                            x: (parent.width - self.width) / 2;
                                            y: (1.0 - ch.streamer-volume / 100.0) * (parent.height - self.height);
                                            border-radius: 4px;
                                            background: #ffdada;
                                            border-width: 1px;
                                            border-color: #ff6b6b;
                                        }
                                    }
                                }
                            }

                            // Pan (L/R balance)
                            HorizontalBox {
                                spacing: 4px;
                                alignment: center;
                                Text { text: "L"; color: #8b8d91; font-size: 9px; vertical-alignment: center; }
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: -100;
                                    maximum: 100;
                                    value: ch.pan;
                                    changed(v) => { root.channel-pan(ch.id, v); }
                                }
                                Text { text: "R"; color: #8b8d91; font-size: 9px; vertical-alignment: center; }
                            }

                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                ConsoleButton {
                                    text: "M";
                                    primary: ch.muted;
                                    clicked => { root.channel-mute(ch.id); }
                                }
                                ConsoleButton {
                                    text: "S";
                                    primary: ch.solo;
                                    clicked => { root.channel-solo(ch.id); }
                                }
                            }

                            // Apps routed to this channel
                            Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2a2b2f;
                                background: #121316;
                                VerticalBox {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text { text: "App"; color: #5a5b5f; font-size: 9px; }
                                    Text {
                                        text: ch.apps == "" ? ch.device : ch.apps;
                                        color: #8b8d91;
                                        font-size: 9px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }


                // ChatMix bar (aligns with the mixer width, does not go beyond)
                Rectangle {
                    height: 72px;
                    width: 832px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    opacity: root.sonar-enabled ? 1.0 : 0.45;

                    VerticalBox {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 4px;

                        HorizontalBox {
                            Text {
                                text: "CHATMIX";
                                color: #8b8d91;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.chatmix-balance;
                                color: #ffffff;
                                font-size: 11px;
                                font-family: "monospace";
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Game"; color: #00e7a0; font-size: 11px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: -100;
                                maximum: 100;
                                value: root.chatmix-balance;
                                enabled: root.sonar-enabled;
                                changed(v) => { root.set-chatmix(v); }
                            }
                            Text { text: "Chat"; color: #3b9eff; font-size: 11px; vertical-alignment: center; }
                        }
                        HorizontalBox {
                            Text {
                                text: "Game " + root.game-volume + "%";
                                color: #8b8d91;
                                font-size: 10px;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: "Chat " + root.chat-volume + "%";
                                color: #8b8d91;
                                font-size: 10px;
                            }
                        }
                    }
                }

                Rectangle { height: 24px; background: transparent; }
            }


            // PRISM — RGB illumination (per device)
            if root.page == 2: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    ConsoleButton {
                        text: "← Engine";
                        clicked => { root.go(0); }
                    }
                    Text {
                        text: "Prism";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "  ·  " + root.selected-device-name;
                        color: #8b8d91;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ConsoleButton {
                        text: "Sync tutti";
                        clicked => { root.prism-sync-all(); }
                    }
                    ConsoleButton {
                        text: "Applica";
                        primary: true;
                        clicked => { root.apply-prism(); }
                    }
                }

                Text {
                    text: "Illumination · effetti e colori sul device selezionato";
                    color: #8b8d91;
                    font-size: 12px;
                }

                HorizontalBox {
                    spacing: 24px;

                    Rectangle {
                        width: 140px;
                        height: 140px;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: #2a2b2f;
                        background: rgb(
                            root.color-r * 255,
                            root.color-g * 255,
                            root.color-b * 255
                        );
                    }

                    VerticalBox {
                        spacing: 10px;
                        horizontal-stretch: 1;

                        Text { text: "EFFETTO"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                        HorizontalBox {
                            spacing: 8px;
                            ConsoleButton {
                                text: "Static";
                                primary: root.prism-effect == "static";
                                clicked => { root.set-prism-effect("static"); }
                            }
                            ConsoleButton {
                                text: "Rainbow";
                                primary: root.prism-effect == "rainbow";
                                clicked => { root.set-prism-effect("rainbow"); }
                            }
                            ConsoleButton {
                                text: "Breathe";
                                primary: root.prism-effect == "breathe";
                                clicked => { root.set-prism-effect("breathe"); }
                            }
                            ConsoleButton {
                                text: "Spectrum";
                                primary: root.prism-effect == "spectrum";
                                clicked => { root.set-prism-effect("spectrum"); }
                            }
                            ConsoleButton {
                                text: "Wave";
                                primary: root.prism-effect == "wave";
                                clicked => { root.set-prism-effect("wave"); }
                            }
                            ConsoleButton {
                                text: "Off";
                                primary: root.prism-effect == "off";
                                clicked => { root.set-prism-effect("off"); }
                            }
                        }

                        Text { text: "ZONA"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                        HorizontalBox {
                            spacing: 8px;
                            ConsoleButton {
                                text: "Logo";
                                primary: root.color-zone == "logo";
                                clicked => { root.color-zone = "logo"; }
                            }
                            ConsoleButton {
                                text: "Scroll";
                                primary: root.color-zone == "scroll";
                                clicked => { root.color-zone = "scroll"; }
                            }
                            ConsoleButton {
                                text: "All";
                                primary: root.color-zone == "all";
                                clicked => { root.color-zone = "all"; }
                            }
                            ConsoleButton {
                                text: "Backlight";
                                primary: root.color-zone == "backlight";
                                clicked => { root.color-zone = "backlight"; }
                            }
                        }

                        Text { text: "COLORE"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                        HorizontalBox {
                            spacing: 12px;
                            VerticalBox {
                                spacing: 4px;
                                Text { text: "R"; color: #e84d8a; font-size: 10px; }
                                Slider {
                                    minimum: 0; maximum: 1;
                                    value: root.color-r;
                                    changed(v) => { root.color-r = v; }
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                Text { text: "G"; color: #00e7a0; font-size: 10px; }
                                Slider {
                                    minimum: 0; maximum: 1;
                                    value: root.color-g;
                                    changed(v) => { root.color-g = v; }
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                Text { text: "B"; color: #3b9eff; font-size: 10px; }
                                Slider {
                                    minimum: 0; maximum: 1;
                                    value: root.color-b;
                                    changed(v) => { root.color-b = v; }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            ConsoleButton {
                                text: "Verde GearCraft";
                                clicked => {
                                    root.color-r = 0;
                                    root.color-g = 0.906;
                                    root.color-b = 0.627;
                                    root.prism-effect = "static";
                                }
                            }
                            ConsoleButton {
                                text: "Bianco";
                                clicked => {
                                    root.color-r = 1;
                                    root.color-g = 1;
                                    root.color-b = 1;
                                    root.prism-effect = "static";
                                }
                            }
                            ConsoleButton {
                                text: "Rosso";
                                clicked => {
                                    root.color-r = 1;
                                    root.color-g = 0.1;
                                    root.color-b = 0.1;
                                    root.prism-effect = "static";
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalBox {
                            Text {
                                text: "DPI MOUSE · libratbag";
                                color: #8b8d91;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: "  " + root.mouse-dpi-label;
                                color: #00e7a0;
                                font-size: 11px;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            ConsoleButton {
                                text: "Aggiorna";
                                clicked => { root.refresh-mouse-info(); }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            ConsoleButton { text: "400"; clicked => { root.set-device-dpi(400); } }
                            ConsoleButton { text: "800"; clicked => { root.set-device-dpi(800); } }
                            ConsoleButton { text: "1600"; clicked => { root.set-device-dpi(1600); } }
                            ConsoleButton { text: "3200"; clicked => { root.set-device-dpi(3200); } }
                            ConsoleButton { text: "6400"; clicked => { root.set-device-dpi(6400); } }
                        }
                    }
                }
            }


            // CAMERA — preview, capture settings, custom effects (under Sonar)
            if root.page == 3: VerticalBox {
                padding: 16px;
                spacing: 12px;

                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: "Camera";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "· sotto Sonar · cattura video / foto · effetti";
                        color: #8b8d91;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ConsoleButton {
                        text: "Aggiorna device";
                        clicked => { root.refresh-cameras(); }
                    }
                    ConsoleButton {
                        text: "Applica settaggi";
                        primary: true;
                        clicked => { root.apply-camera-settings(); }
                    }
                }

                HorizontalBox {
                    spacing: 12px;
                    vertical-stretch: 1;

                    // Left: preview + device
                    VerticalBox {
                        spacing: 10px;
                        width: 420px;

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 260px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: root.camera-preview-active ? #00e7a0 : #2a2b2f;
                            background: #0a0b0d;
                            clip: true;

                            // Live frames
                            Image {
                                x: 0; y: 0;
                                width: parent.width;
                                height: parent.height;
                                source: root.camera-frame;
                                source-clip-x: 0;
                                source-clip-y: 0;
                                image-fit: contain;
                                opacity: root.camera-preview-active ? 1.0 : 0.35;
                            }

                            // Overlay status
                            Rectangle {
                                x: 0; y: 0;
                                width: parent.width;
                                height: 56px;
                                background: #000000aa;

                                VerticalBox {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text {
                                        text: root.camera-preview-active ? "● LIVE" : "○ STANDBY";
                                        color: root.camera-preview-active ? #00e7a0 : #8b8d91;
                                        font-size: 11px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.camera-device-label + "  ·  " + root.camera-preview-status;
                                        color: #c8c9cc;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.cam-video-resolution + " @ " + root.cam-video-fps + " fps · " + root.cam-video-format;
                                        color: #8b8d91;
                                        font-size: 9px;
                                    }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            ConsoleButton {
                                text: root.camera-preview-active ? "Stop preview" : "Avvia preview";
                                primary: !root.camera-preview-active;
                                clicked => { root.toggle-camera-preview(); }
                            }
                            ConsoleButton {
                                text: root.cam-video-recording ? "■ Stop REC" : "● Rec video";
                                clicked => { root.toggle-cam-recording(); }
                            }
                            ConsoleButton {
                                text: "Scatta foto";
                                primary: true;
                                clicked => { root.capture-photo(); }
                            }
                        }

                        Text { text: "DISPOSITIVO"; color: #8b8d91; font-size: 10px; font-weight: 700; }
                        ScrollView {
                            height: 100px;
                            VerticalBox {
                                spacing: 4px;
                                for cam in root.camera-devices: Rectangle {
                                    height: 32px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: cam.id == root.camera-device-id ? #00e7a0 : #2a2b2f;
                                    background: #1a1b1e;
                                    TouchArea {
                                        clicked => { root.select-camera(cam.id); }
                                        HorizontalBox {
                                            padding: 6px;
                                            spacing: 8px;
                                            Rectangle {
                                                width: 6px; height: 6px; y: 6px;
                                                border-radius: 3px;
                                                background: cam.available ? #00e7a0 : #5a5b5f;
                                            }
                                            Text {
                                                text: cam.label;
                                                color: #e6e7e9;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                                if root.camera-devices.length == 0: Text {
                                    text: "Nessuna /dev/video* trovata";
                                    color: #8b8d91;
                                    font-size: 11px;
                                }
                            }
                        }
                    }

                    // Right: settings tabs-ish + effects
                    VerticalBox {
                        spacing: 10px;
                        horizontal-stretch: 1;

                        HorizontalBox {
                            spacing: 6px;
                            ConsoleButton {
                                text: "Video";
                                primary: root.camera-mode == "video";
                                clicked => { root.set-camera-mode("video"); }
                            }
                            ConsoleButton {
                                text: "Foto";
                                primary: root.camera-mode == "photo";
                                clicked => { root.set-camera-mode("photo"); }
                            }
                            ConsoleButton {
                                text: "Immagine";
                                primary: root.camera-mode == "image";
                                clicked => { root.set-camera-mode("image"); }
                            }
                            ConsoleButton {
                                text: "Effetti";
                                primary: root.camera-mode == "effects";
                                clicked => { root.set-camera-mode("effects"); }
                            }
                        }

                        // VIDEO settings
                        if root.camera-mode == "video": VerticalBox {
                            spacing: 8px;
                            Text { text: "CATTURA VIDEO"; color: #8b8d91; font-size: 11px; font-weight: 700; }

                            Text { text: "Risoluzione"; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "640x480"; primary: root.cam-video-resolution == "640x480"; clicked => { root.set-cam-video-resolution("640x480"); } }
                                ConsoleButton { text: "1280x720"; primary: root.cam-video-resolution == "1280x720"; clicked => { root.set-cam-video-resolution("1280x720"); } }
                                ConsoleButton { text: "1920x1080"; primary: root.cam-video-resolution == "1920x1080"; clicked => { root.set-cam-video-resolution("1920x1080"); } }
                                ConsoleButton { text: "3840x2160"; primary: root.cam-video-resolution == "3840x2160"; clicked => { root.set-cam-video-resolution("3840x2160"); } }
                            }

                            Text { text: "FPS: " + root.cam-video-fps; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "24"; primary: root.cam-video-fps == 24; clicked => { root.set-cam-video-fps(24); } }
                                ConsoleButton { text: "30"; primary: root.cam-video-fps == 30; clicked => { root.set-cam-video-fps(30); } }
                                ConsoleButton { text: "60"; primary: root.cam-video-fps == 60; clicked => { root.set-cam-video-fps(60); } }
                                ConsoleButton { text: "120"; primary: root.cam-video-fps == 120; clicked => { root.set-cam-video-fps(120); } }
                            }

                            Text { text: "Formato"; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "MJPG"; primary: root.cam-video-format == "MJPG"; clicked => { root.set-cam-video-format("MJPG"); } }
                                ConsoleButton { text: "YUYV"; primary: root.cam-video-format == "YUYV"; clicked => { root.set-cam-video-format("YUYV"); } }
                                ConsoleButton { text: "H264"; primary: root.cam-video-format == "H264"; clicked => { root.set-cam-video-format("H264"); } }
                                ConsoleButton { text: "NV12"; primary: root.cam-video-format == "NV12"; clicked => { root.set-cam-video-format("NV12"); } }
                            }

                            Text { text: "Bitrate: " + root.cam-video-bitrate + " Mbps"; color: #8b8d91; font-size: 10px; }
                            Slider {
                                minimum: 1; maximum: 50; value: root.cam-video-bitrate;
                                changed(v) => { root.set-cam-video-bitrate(v); }
                            }
                        }

                        // PHOTO settings
                        if root.camera-mode == "photo": VerticalBox {
                            spacing: 8px;
                            Text { text: "CATTURA FOTO"; color: #8b8d91; font-size: 11px; font-weight: 700; }

                            Text { text: "Risoluzione"; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "1280x720"; primary: root.cam-photo-resolution == "1280x720"; clicked => { root.set-cam-photo-resolution("1280x720"); } }
                                ConsoleButton { text: "1920x1080"; primary: root.cam-photo-resolution == "1920x1080"; clicked => { root.set-cam-photo-resolution("1920x1080"); } }
                                ConsoleButton { text: "3840x2160"; primary: root.cam-photo-resolution == "3840x2160"; clicked => { root.set-cam-photo-resolution("3840x2160"); } }
                                ConsoleButton { text: "Max sensor"; primary: root.cam-photo-resolution == "max"; clicked => { root.set-cam-photo-resolution("max"); } }
                            }

                            Text { text: "Formato"; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "JPEG"; primary: root.cam-photo-format == "JPEG"; clicked => { root.set-cam-photo-format("JPEG"); } }
                                ConsoleButton { text: "PNG"; primary: root.cam-photo-format == "PNG"; clicked => { root.set-cam-photo-format("PNG"); } }
                                ConsoleButton { text: "RAW"; primary: root.cam-photo-format == "RAW"; clicked => { root.set-cam-photo-format("RAW"); } }
                            }

                            Text { text: "Qualità JPEG: " + root.cam-photo-quality + "%"; color: #8b8d91; font-size: 10px; }
                            Slider {
                                minimum: 10; maximum: 100; value: root.cam-photo-quality;
                                changed(v) => { root.set-cam-photo-quality(v); }
                            }

                            Text { text: "Timer (s): " + root.cam-photo-timer; color: #8b8d91; font-size: 10px; }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "0"; primary: root.cam-photo-timer == 0; clicked => { root.set-cam-photo-timer(0); } }
                                ConsoleButton { text: "3"; primary: root.cam-photo-timer == 3; clicked => { root.set-cam-photo-timer(3); } }
                                ConsoleButton { text: "5"; primary: root.cam-photo-timer == 5; clicked => { root.set-cam-photo-timer(5); } }
                                ConsoleButton { text: "10"; primary: root.cam-photo-timer == 10; clicked => { root.set-cam-photo-timer(10); } }
                            }
                        }

                        // IMAGE controls
                        if root.camera-mode == "image": VerticalBox {
                            spacing: 6px;
                            Text { text: "CONTROLLI IMMAGINE"; color: #8b8d91; font-size: 11px; font-weight: 700; }

                            Text { text: "Luminosità " + root.cam-brightness; color: #8b8d91; font-size: 10px; }
                            Slider { minimum: 0; maximum: 100; value: root.cam-brightness; changed(v) => { root.set-cam-brightness(v); } }
                            Text { text: "Contrasto " + root.cam-contrast; color: #8b8d91; font-size: 10px; }
                            Slider { minimum: 0; maximum: 100; value: root.cam-contrast; changed(v) => { root.set-cam-contrast(v); } }
                            Text { text: "Saturazione " + root.cam-saturation; color: #8b8d91; font-size: 10px; }
                            Slider { minimum: 0; maximum: 100; value: root.cam-saturation; changed(v) => { root.set-cam-saturation(v); } }
                            Text { text: "Nitidezza " + root.cam-sharpness; color: #8b8d91; font-size: 10px; }
                            Slider { minimum: 0; maximum: 100; value: root.cam-sharpness; changed(v) => { root.set-cam-sharpness(v); } }
                            Text { text: "Esposizione " + root.cam-exposure; color: #8b8d91; font-size: 10px; }
                            Slider { minimum: 0; maximum: 100; value: root.cam-exposure; enabled: !root.cam-auto-exposure; changed(v) => { root.set-cam-exposure(v); } }

                            HorizontalBox {
                                spacing: 8px;
                                ConsoleButton {
                                    text: root.cam-auto-exposure ? "Auto exp: ON" : "Auto exp: OFF";
                                    primary: root.cam-auto-exposure;
                                    clicked => { root.toggle-cam-auto-exposure(); }
                                }
                                ConsoleButton {
                                    text: root.cam-auto-wb ? "Auto WB: ON" : "Auto WB: OFF";
                                    primary: root.cam-auto-wb;
                                    clicked => { root.toggle-cam-auto-wb(); }
                                }
                            }
                            Text { text: "WB temp " + root.cam-wb-temp + " K"; color: #8b8d91; font-size: 10px; }
                            Slider {
                                minimum: 2500; maximum: 8000; value: root.cam-wb-temp;
                                enabled: !root.cam-auto-wb;
                                changed(v) => { root.set-cam-wb-temp(v); }
                            }
                        }

                        // EFFECTS
                        if root.camera-mode == "effects": VerticalBox {
                            spacing: 8px;
                            vertical-stretch: 1;
                            Text { text: "EFFETTI VIDEO PERSONALIZZATI"; color: #8b8d91; font-size: 11px; font-weight: 700; }

                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton { text: "+ Blur"; clicked => { root.add-camera-effect("blur"); } }
                                ConsoleButton { text: "+ Color grade"; clicked => { root.add-camera-effect("color_grade"); } }
                                ConsoleButton { text: "+ Vignette"; clicked => { root.add-camera-effect("vignette"); } }
                                ConsoleButton { text: "+ Mirror"; clicked => { root.add-camera-effect("mirror"); } }
                                ConsoleButton { text: "+ Overlay"; clicked => { root.add-camera-effect("overlay"); } }
                                ConsoleButton { text: "+ Sharpen"; clicked => { root.add-camera-effect("sharpen"); } }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalBox {
                                    spacing: 6px;
                                    for fx in root.camera-effects: Rectangle {
                                        height: 64px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: fx.enabled ? #00e7a0 : #2a2b2f;
                                        background: #1a1b1e;

                                        VerticalBox {
                                            padding: 8px;
                                            spacing: 4px;
                                            HorizontalBox {
                                                Text {
                                                    text: fx.name + "  (" + fx.kind + ")";
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                                ConsoleButton {
                                                    text: fx.enabled ? "ON" : "OFF";
                                                    primary: fx.enabled;
                                                    clicked => { root.toggle-camera-effect(fx.id); }
                                                }
                                                ConsoleButton {
                                                    text: "✕";
                                                    clicked => { root.remove-camera-effect(fx.id); }
                                                }
                                            }
                                            Text {
                                                text: "Intensità " + fx.intensity + "%";
                                                color: #8b8d91;
                                                font-size: 10px;
                                            }
                                            Slider {
                                                minimum: 0; maximum: 100; value: fx.intensity;
                                                changed(v) => { root.set-camera-effect-intensity(fx.id, v); }
                                            }
                                        }
                                    }
                                    if root.camera-effects.length == 0: Text {
                                        text: "Nessun effetto. Aggiungine uno sopra.";
                                        color: #8b8d91;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // SCREEN CAPTURE — Spectacle-style GUI
            if root.page == 4: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    Text {
                        text: "Cattura schermo";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: "  ·  stile Spectacle";
                        color: #8b8d91;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.capture-status;
                        color: #00e7a0;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Scegli cosa catturare, un eventuale ritardo, poi Avvia.";
                    color: #8b8d91;
                    font-size: 12px;
                }

                // Mode cards
                HorizontalBox {
                    spacing: 12px;

                    Rectangle {
                        border-radius: 14px;
                        border-width: 2px;
                        border-color: root.capture-mode == "full" ? #00e7a0 : #2a2b2f;
                        background: root.capture-mode == "full" ? #12332c : #1a1b1e;
                        min-width: 160px;
                        height: 120px;
                        TouchArea {
                            clicked => { root.set-capture-mode("full"); }
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text {
                                    text: "🖥";
                                    font-size: 28px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Schermo intero";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Tutto il display";
                                    color: #8b8d91;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 14px;
                        border-width: 2px;
                        border-color: root.capture-mode == "window" ? #00e7a0 : #2a2b2f;
                        background: root.capture-mode == "window" ? #12332c : #1a1b1e;
                        min-width: 160px;
                        height: 120px;
                        TouchArea {
                            clicked => { root.set-capture-mode("window"); }
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text {
                                    text: "🗔";
                                    font-size: 28px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Finestra";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Finestra attiva";
                                    color: #8b8d91;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 14px;
                        border-width: 2px;
                        border-color: root.capture-mode == "region" ? #00e7a0 : #2a2b2f;
                        background: root.capture-mode == "region" ? #12332c : #1a1b1e;
                        min-width: 160px;
                        height: 120px;
                        TouchArea {
                            clicked => { root.set-capture-mode("region"); }
                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;
                                Text {
                                    text: "⬚";
                                    font-size: 28px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Regione";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Selezione area";
                                    color: #8b8d91;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Options
                Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "OPZIONI";
                            color: #8b8d91;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Text {
                                text: "Ritardo";
                                color: #e6e7e9;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 80px;
                            }
                            HorizontalBox {
                                spacing: 6px;
                                ConsoleButton {
                                    text: "0 s";
                                    primary: root.capture-delay == 0;
                                    clicked => { root.set-capture-delay(0); }
                                }
                                ConsoleButton {
                                    text: "2 s";
                                    primary: root.capture-delay == 2;
                                    clicked => { root.set-capture-delay(2); }
                                }
                                ConsoleButton {
                                    text: "5 s";
                                    primary: root.capture-delay == 5;
                                    clicked => { root.set-capture-delay(5); }
                                }
                                ConsoleButton {
                                    text: "10 s";
                                    primary: root.capture-delay == 10;
                                    clicked => { root.set-capture-delay(10); }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Text {
                                text: "Clipboard";
                                color: #e6e7e9;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 80px;
                            }
                            ConsoleButton {
                                text: root.capture-clipboard ? "Copia dopo cattura: ON" : "Copia dopo cattura: OFF";
                                primary: root.capture-clipboard;
                                clicked => { root.toggle-capture-clipboard(); }
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Text {
                                text: "Cartella";
                                color: #e6e7e9;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 80px;
                            }
                            Text {
                                text: "~/Pictures/GearCraft";
                                color: #8b8d91;
                                font-size: 12px;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Last capture + main action
                Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #141518;
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "ULTIMA CATTURA";
                            color: #8b8d91;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.capture-last-path;
                            color: #ffffff;
                            font-size: 12px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 12px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ConsoleButton {
                        text: "Annulla / Engine";
                        clicked => { root.go(0); }
                    }
                    ConsoleButton {
                        text: "▶  Avvia cattura";
                        primary: true;
                        clicked => { root.start-capture(); }
                    }
                }

                Text {
                    text: "Backend: Spectacle → GNOME → grim/slurp → maim/scrot";
                    color: #5a5b5f;
                    font-size: 10px;
                }
            }

            if root.page == 5: VerticalBox {
                padding: 16px;
                spacing: 10px;

                HorizontalBox {
                    ConsoleButton {
                        text: "← Sonar";
                        clicked => { root.go(1); }
                    }
                    Text {
                        text: root.fx-channel == "" ? ("Preset / FX — " + root.active-preset-name) : ("FX — " + root.fx-channel);
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ConsoleButton {
                        text: "Applica preset";
                        primary: true;
                        clicked => { root.load-preset(root.active-preset-id); }
                    }
                }

                Text {
                    text: "Tutte le regolazioni del preset attivo";
                    color: #8b8d91;
                    font-size: 12px;
                }

                // Interactive 10-band EQ
                Rectangle {
                    height: 200px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "EQUALIZER"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                            Text {
                                text: "  −12 dB  ·  +12 dB";
                                color: #5a5b5f; font-size: 10px;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            ConsoleButton {
                                text: root.eq-enabled ? "EQ: ON" : "EQ: OFF";
                                primary: root.eq-enabled;
                                clicked => { root.toggle-eq(); }
                            }
                            ConsoleButton { text: "Reset EQ"; clicked => { root.reset-eq(); } }
                            ConsoleButton { text: "Applica EQ"; primary: true; clicked => { root.apply-eq(); } }
                        }
                        // Graph + faders
                        HorizontalBox {
                            spacing: 4px;
                            vertical-stretch: 1;
                            for band in root.eq-bands: VerticalBox {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                // Gain readout
                                Text {
                                    text: band.gain;
                                    color: band.gain == 0 ? #5a5b5f : #00e7a0;
                                    font-size: 9px;
                                    font-family: "monospace";
                                    horizontal-alignment: center;
                                }
                                // Vertical fader track
                                Rectangle {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    min-height: 110px;
                                    border-radius: 6px;
                                    background: #121316;
                                    // zero line
                                    Rectangle {
                                        y: parent.height / 2 - 0.5px;
                                        height: 1px;
                                        width: 100%;
                                        background: #2a2b2f;
                                    }
                                    // fill from center toward gain
                                    Rectangle {
                                        width: 8px;
                                        x: (parent.width - 8px) / 2;
                                        height: Math.abs(band.gain) / 12 * (parent.height / 2);
                                        y: band.gain >= 0
                                            ? parent.height / 2 - self.height
                                            : parent.height / 2;
                                        border-radius: 3px;
                                        background: root.eq-enabled ? #00e7a0 : #3a3b3f;
                                    }
                                    // draggable thumb
                                    Rectangle {
                                        width: 14px;
                                        height: 8px;
                                        x: (parent.width - 14px) / 2;
                                        y: parent.height / 2 - (band.gain / 12) * (parent.height / 2) - 4px;
                                        border-radius: 3px;
                                        background: #ffffff;
                                    }
                                    TouchArea {
                                        moved => {
                                            if (self.pressed) {
                                                // top = +12, bottom = -12
                                                root.eq-band-gain(band.index, Math.max(-12, Math.min(12, (0.5 - self.mouse-y / self.height) * 24)));
                                            }
                                        }
                                        clicked => {
                                            root.eq-band-gain(band.index, Math.max(-12, Math.min(12, (0.5 - self.mouse-y / self.height) * 24)));
                                        }
                                    }
                                }
                                Text {
                                    text: band.freq-label;
                                    color: #8b8d91;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Spatial + volume (Sonar Game/Chat FX)
                Rectangle {
                    height: 110px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "SPATIAL / BOOST"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            ConsoleButton {
                                text: root.spatial-enabled ? "Spatial: ON" : "Spatial: OFF";
                                primary: root.spatial-enabled;
                                clicked => { root.toggle-spatial(); }
                            }
                            ConsoleButton {
                                text: root.smart-volume ? "Smart Vol: ON" : "Smart Vol: OFF";
                                primary: root.smart-volume;
                                clicked => { root.toggle-smart-volume(); }
                            }
                            ConsoleButton {
                                text: "Reset FX";
                                clicked => { root.reset-all-fx(); }
                            }
                            ConsoleButton {
                                text: "Applica FX";
                                primary: true;
                                clicked => { root.apply-spatial(); }
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Perf"; color: #3b9eff; font-size: 10px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 100;
                                value: root.spatial-immersion;
                                changed(v) => { root.set-spatial-immersion(v); }
                            }
                            Text { text: "Immers"; color: #e84d8a; font-size: 10px; vertical-alignment: center; }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Near"; color: #8b8d91; font-size: 10px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 100;
                                value: root.spatial-distance;
                                changed(v) => { root.set-spatial-distance(v); }
                            }
                            Text { text: "Far"; color: #8b8d91; font-size: 10px; vertical-alignment: center; }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Boost dB"; color: #f5a524; font-size: 10px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: -6;
                                maximum: 12;
                                value: root.volume-boost;
                                changed(v) => { root.set-volume-boost(v); }
                            }
                            Text {
                                text: root.volume-boost;
                                color: #ffffff;
                                font-size: 11px;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Microphone FX
                Rectangle {
                    height: 108px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "MICROPHONE"; color: #f5a524; font-size: 11px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            ConsoleButton {
                                text: root.mic-muted ? "Unmute" : "Mute";
                                clicked => { root.toggle-mic-mute(); }
                            }
                            ConsoleButton {
                                text: root.mic-highpass ? "HPF: ON" : "HPF: OFF";
                                primary: root.mic-highpass;
                                clicked => { root.toggle-mic-highpass(); }
                            }
                            ConsoleButton {
                                text: root.mic-noise-gate ? "Gate: ON" : "Gate: OFF";
                                primary: root.mic-noise-gate;
                                clicked => { root.toggle-mic-gate(); }
                            }
                            ConsoleButton {
                                text: root.mic-lowpass ? "LPF: ON" : "LPF: OFF";
                                primary: root.mic-lowpass;
                                clicked => { root.toggle-mic-lowpass(); }
                            }
                            ConsoleButton {
                                text: root.mic-compressor ? "Comp: ON" : "Comp: OFF";
                                primary: root.mic-compressor;
                                clicked => { root.toggle-mic-compressor(); }
                            }
                            ConsoleButton { text: "Aggiorna"; clicked => { root.refresh-mic-fx(); } }
                            ConsoleButton { text: "Applica Mic"; primary: true; clicked => { root.apply-mic-fx(); } }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Gain"; color: #8b8d91; font-size: 11px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 150;
                                value: root.mic-gain;
                                changed(v) => { root.set-mic-gain(v); }
                            }
                            Text {
                                text: root.mic-gain + "%";
                                color: #ffffff;
                                font-size: 11px;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                    }
                }


            }
        }
    }


        } // end main VerticalBox (title + body)

        // Settings panel (themed overlay)
        if root.show-settings: Rectangle {
            x: 0; y: 0;
            width: 100%;
            height: 100%;
            background: #00000099;
            TouchArea { clicked => { root.show-settings = false; } }

            Rectangle {
                width: 420px;
                height: 320px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2a2b2f;
                background: #1a1b1e;

                VerticalBox {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "Impostazioni";
                        color: #ffffff;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Preferenze applicazione GearCraft";
                        color: #8b8d91;
                        font-size: 12px;
                    }
                    Rectangle { height: 1px; background: #2a2b2f; }
                    Text {
                        text: "• Tema: scuro (accent #00E7A0)\n• UI: Slint client-side decorations\n• Daemon: socket Unix XDG_RUNTIME_DIR\n• Camera: V4L2 preview";
                        color: #c8c9cc;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalBox {
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ConsoleButton {
                            text: "Chiudi";
                            primary: true;
                            clicked => { root.show-settings = false; }
                        }
                    }
                }
            }
        }

        // Help panel
        if root.show-help: Rectangle {
            x: 0; y: 0;
            width: 100%;
            height: 100%;
            background: #00000099;
            TouchArea { clicked => { root.show-help = false; } }

            Rectangle {
                width: 440px;
                height: 340px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                border-width: 1px;
                border-color: #00e7a040;
                background: #1a1b1e;

                VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text {
                        text: "Aiuto · GearCraft";
                        color: #00e7a0;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Engine — RGB e device HID\nSonar — mixer, ChatMix, EQ, mic\nCamera — preview V4L2, foto, effetti\nPrism — effetti illuminazione\nCattura — screenshot integrata\n\nTitle bar: ⚙ impostazioni · ? aiuto · — □ ✕ finestra";
                        color: #c8c9cc;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalBox {
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ConsoleButton {
                            text: "OK";
                            primary: true;
                            clicked => { root.show-help = false; }
                        }
                    }
                }
            }
        }
    }
}
