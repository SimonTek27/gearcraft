// GearCraft — Slint UI (dark, accent #00E7A0)

import { Button, VerticalBox, HorizontalBox, Slider, ScrollView } from "std-widgets.slint";

export struct DeviceRow {
    id: string,
    name: string,
    vendor: string,
    kind: string,
    online: bool,
    detail: string,
}

export struct ChannelRow {
    id: string,
    label: string,
    color: string,
    volume: int,
    muted: bool,
    solo: bool,
    device: string,
}

export struct PresetRow {
    id: string,
    name: string,
    notes: string,
    eq-enabled: bool,
}

export component App inherits Window {
    title: "GearCraft";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: #0f1013;

    in-out property <int> page: 0;
    in-out property <string> status-text: "Connecting…";
    in-out property <bool> daemon-online: false;
    in-out property <[DeviceRow]> devices: [];
    in-out property <string> selected-device-id: "";
    in-out property <string> selected-device-name: "—";
    in-out property <float> color-r: 0;
    in-out property <float> color-g: 0.906;
    in-out property <float> color-b: 0.627;
    in-out property <string> color-zone: "logo";
    in-out property <int> chatmix-balance: 0;
    in-out property <int> game-volume: 100;
    in-out property <int> chat-volume: 100;
    in-out property <string> chatmix-backend: "—";
    in-out property <bool> chatmix-ready: false;
    in-out property <bool> streamer-mode: true;
    in-out property <bool> sonar-enabled: true;
    in-out property <[PresetRow]> presets: [];
    in-out property <string> active-preset-id: "";
    in-out property <string> active-preset-name: "—";
    in-out property <string> preset-name-input: "";
    in-out property <[ChannelRow]> channels: [
        { id: "master", label: "MASTER", color: "#8b8d91", volume: 100, muted: false, solo: false, device: "System" },
        { id: "game", label: "GAME", color: "#00e7a0", volume: 100, muted: false, solo: false, device: "GearCraft_Game" },
        { id: "chat", label: "CHAT", color: "#3b9eff", volume: 100, muted: false, solo: false, device: "GearCraft_Chat" },
        { id: "media", label: "MEDIA", color: "#e84d8a", volume: 100, muted: false, solo: false, device: "Default" },
        { id: "aux", label: "AUX", color: "#a78bfa", volume: 100, muted: false, solo: false, device: "Default" },
        { id: "mic", label: "MIC", color: "#f5a524", volume: 100, muted: false, solo: false, device: "Input" },
    ];

    callback refresh-devices();
    callback select-device(string);
    callback apply-color();
    callback set-chatmix(int);
    callback setup-chatmix();
    callback channel-volume(string, int);
    callback channel-mute(string);
    callback channel-solo(string);
    callback toggle-streamer();
    callback toggle-sonar();
    callback refresh-presets();
    callback load-preset(string);
    callback save-preset(string);
    callback delete-preset(string);

    HorizontalBox {
        padding: 0;
        spacing: 0;

        Rectangle {
            width: 200px;
            background: #141518;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "GearCraft"; color: #00e7a0; font-size: 18px; font-weight: 700; }
                Text {
                    text: root.status-text;
                    color: root.daemon-online ? #00e7a0 : #8b8d91;
                    font-size: 11px;
                }
                Rectangle { height: 12px; background: transparent; }
                Button { text: "Home"; primary: root.page == 0; clicked => { root.page = 0; } }
                Button { text: "Engine"; primary: root.page == 1; clicked => { root.page = 1; } }
                Button { text: "Sonar"; primary: root.page == 2; clicked => { root.page = 2; } }
                Rectangle { height: 1px; background: #2a2b2f; }
                Button { text: "Refresh"; clicked => { root.refresh-devices(); } }
            }
        }

        Rectangle {
            background: #0f1013;

            if root.page == 0: VerticalBox {
                padding: 24px;
                spacing: 12px;
                Text { text: "Devices"; color: #ffffff; font-size: 22px; font-weight: 700; }
                Text { text: "Peripherals discovered by the daemon."; color: #8b8d91; font-size: 12px; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        spacing: 8px;
                        for dev in root.devices: Rectangle {
                            height: 64px;
                            background: #1a1b1e;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: dev.id == root.selected-device-id ? #00e7a0 : #2a2b2f;
                            TouchArea {
                                clicked => { root.select-device(dev.id); }
                                HorizontalBox {
                                    padding: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 8px; height: 8px; y: 10px; border-radius: 4px;
                                        background: dev.online ? #00e7a0 : #5a5b5f;
                                    }
                                    VerticalBox {
                                        spacing: 2px;
                                        Text { text: dev.name; color: #ffffff; font-size: 14px; font-weight: 600; }
                                        Text {
                                            text: dev.vendor + " · " + dev.kind + " · " + dev.detail;
                                            color: #8b8d91; font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                        if root.devices.length == 0: Text {
                            text: "No devices (start gearcraft-daemon or plug hardware).";
                            color: #8b8d91;
                        }
                    }
                }
            }

            if root.page == 1: VerticalBox {
                padding: 24px;
                spacing: 16px;
                Text { text: "Engine"; color: #ffffff; font-size: 22px; font-weight: 700; }
                Text {
                    text: "RGB · selected: " + root.selected-device-name;
                    color: #8b8d91; font-size: 12px;
                }
                HorizontalBox {
                    spacing: 24px;
                    Rectangle {
                        width: 120px; height: 120px; border-radius: 12px;
                        border-width: 1px; border-color: #2a2b2f;
                        background: rgb(root.color-r * 255, root.color-g * 255, root.color-b * 255);
                    }
                    VerticalBox {
                        spacing: 8px;
                        Text { text: "Red"; color: #8b8d91; font-size: 11px; }
                        Slider { minimum: 0; maximum: 1; value: root.color-r; changed(v) => { root.color-r = v; } }
                        Text { text: "Green"; color: #8b8d91; font-size: 11px; }
                        Slider { minimum: 0; maximum: 1; value: root.color-g; changed(v) => { root.color-g = v; } }
                        Text { text: "Blue"; color: #8b8d91; font-size: 11px; }
                        Slider { minimum: 0; maximum: 1; value: root.color-b; changed(v) => { root.color-b = v; } }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: "Logo"; primary: root.color-zone == "logo"; clicked => { root.color-zone = "logo"; } }
                            Button { text: "All"; primary: root.color-zone == "all"; clicked => { root.color-zone = "all"; } }
                            Button { text: "Apply colour"; primary: true; clicked => { root.apply-color(); } }
                        }
                    }
                }
            }

            if root.page == 2: VerticalBox {
                padding: 16px;
                spacing: 10px;

                HorizontalBox {
                    Text { text: "Sonar"; color: #ffffff; font-size: 22px; font-weight: 700; }
                    Text {
                        text: root.streamer-mode ? "  ·  Modalità streamer" : "";
                        color: #8b8d91; font-size: 13px; vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.chatmix-backend + (root.chatmix-ready ? " · ready" : " · not linked");
                        color: root.chatmix-ready ? #00e7a0 : #8b8d91;
                        font-size: 11px; vertical-alignment: center;
                    }
                    Button {
                        text: root.streamer-mode ? "Streamer: ON" : "Streamer: OFF";
                        primary: root.streamer-mode;
                        clicked => { root.toggle-streamer(); }
                    }
                    Button {
                        text: root.sonar-enabled ? "Spegni Sonar" : "Accendi Sonar";
                        clicked => { root.toggle-sonar(); }
                    }
                    Button { text: "Setup sinks"; clicked => { root.setup-chatmix(); } }
                }

                HorizontalBox {
                    spacing: 8px;
                    vertical-stretch: 1;

                    for ch in root.channels: Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #2a2b2f;
                        background: #1a1b1e;
                        opacity: root.sonar-enabled ? 1.0 : 0.45;
                        min-width: 120px;

                        VerticalBox {
                            padding: 10px 8px;
                            spacing: 6px;

                            HorizontalBox {
                                spacing: 4px;
                                Text {
                                    text: ch.label;
                                    color: ch.color;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    width: 22px;
                                    height: 22px;
                                    Rectangle {
                                        border-radius: 6px;
                                        background: parent.has-hover ? #2a2b2f : transparent;
                                        Text {
                                            text: "⚙";
                                            color: #8b8d91;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: ch.device;
                                    color: #8b8d91;
                                    font-size: 10px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                // Progress ring (track + arc) + % center
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    background: transparent;

                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: #2a2b2f;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        MoveTo { x: 50; y: 10; }
                                        ArcTo {
                                            radius-x: 40;
                                            radius-y: 40;
                                            x: 49.99;
                                            y: 10;
                                            large-arc: true;
                                            sweep: true;
                                        }
                                    }
                                    Path {
                                        width: 100%;
                                        height: 100%;
                                        viewbox-width: 100;
                                        viewbox-height: 100;
                                        stroke: ch.muted ? #5a5b5f : ch.color;
                                        stroke-width: 3.5px;
                                        fill: transparent;
                                        private property <float> p: Math.min(0.9999, ch.volume / 100);
                                        private property <float> r: 40;
                                        private property <float> cx: 50;
                                        private property <float> cy: 50;
                                        MoveTo {
                                            x: cx;
                                            y: cy - r;
                                        }
                                        ArcTo {
                                            radius-x: r;
                                            radius-y: r;
                                            x: cx + r * Math.sin(p * 360deg);
                                            y: cy - r * Math.cos(p * 360deg);
                                            sweep: p > 0;
                                            large-arc: p > 0.5;
                                        }
                                    }
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: ch.volume + "%";
                                        color: #ffffff;
                                        font-size: 8px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.streamer-mode: HorizontalBox {
                                spacing: 12px;
                                alignment: center;
                                height: 90px;
                                VerticalBox {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: "🎧"; font-size: 11px; horizontal-alignment: center; }
                                    Rectangle {
                                        width: 14px;
                                        vertical-stretch: 1;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : ch.color;
                                        }
                                    }
                                }
                                VerticalBox {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: "📡"; font-size: 11px; horizontal-alignment: center; }
                                    Rectangle {
                                        width: 14px;
                                        vertical-stretch: 1;
                                        border-radius: 3px;
                                        background: #0f1013;
                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height * (ch.volume / 100.0);
                                            y: parent.height - self.height;
                                            border-radius: 3px;
                                            background: ch.muted ? #3a3b3f : ch.color;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 160px;
                                horizontal-stretch: 1;
                                Rectangle {
                                    width: 6px;
                                    height: parent.height - 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: 8px;
                                    border-radius: 3px;
                                    background: #0f1013;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height * (ch.volume / 100.0);
                                        y: parent.height - self.height;
                                        border-radius: 3px;
                                        background: ch.muted ? #3a3b3f : ch.color;
                                        opacity: 0.4;
                                    }
                                }
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: root.sonar-enabled;
                                    moved => {
                                        if (self.pressed) {
                                            root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                        }
                                    }
                                    clicked => {
                                        root.channel-volume(ch.id, Math.max(0, Math.min(100, Math.round((1.0 - self.mouse-y / self.height) * 100.0))));
                                    }
                                    Rectangle {
                                        width: 22px;
                                        height: 14px;
                                        x: (parent.width - self.width) / 2;
                                        y: (1.0 - ch.volume / 100.0) * (parent.height - self.height);
                                        border-radius: 4px;
                                        background: #f0f0f2;
                                        border-width: 1px;
                                        border-color: #ffffff;
                                        VerticalBox {
                                            padding: 3px;
                                            spacing: 2px;
                                            alignment: center;
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                            Rectangle { height: 1px; width: 12px; background: #9a9b9f; }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: ch.muted ? "-inf dB" : (ch.volume >= 100 ? "0 dB" : "-" + (Math.round((100 - ch.volume) * 0.2)) + " dB");
                                color: #8b8d91;
                                font-size: 10px;
                                font-family: "monospace";
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2a2b2f;
                                background: #121316;
                                HorizontalBox {
                                    padding: 4px 8px;
                                    spacing: 4px;
                                    Text { text: "App"; color: #5a5b5f; font-size: 10px; vertical-alignment: center; }
                                    Text {
                                        text: ch.device;
                                        color: #8b8d91;
                                        font-size: 10px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text { text: ">"; color: #5a5b5f; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            HorizontalBox {
                                spacing: 6px;
                                alignment: center;
                                Button { text: "M"; primary: ch.muted; clicked => { root.channel-mute(ch.id); } }
                                Button { text: "S"; primary: ch.solo; clicked => { root.channel-solo(ch.id); } }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 130px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    VerticalBox {
                        padding: 10px 12px;
                        spacing: 6px;
                        HorizontalBox {
                            Text { text: "PRESET AUDIO"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                            Text {
                                text: "  attivo: " + root.active-preset-name;
                                color: #00e7a0; font-size: 11px;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: "Aggiorna"; clicked => { root.refresh-presets(); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            ScrollView {
                                horizontal-stretch: 1;
                                VerticalBox {
                                    spacing: 4px;
                                    for p in root.presets: HorizontalBox {
                                        spacing: 8px;
                                        Text {
                                            text: p.name + (p.eq-enabled ? "  · EQ" : "");
                                            color: p.id == root.active-preset-id ? #00e7a0 : #ffffff;
                                            font-size: 12px; vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Button {
                                            text: "Carica";
                                            primary: p.id == root.active-preset-id;
                                            clicked => { root.load-preset(p.id); }
                                        }
                                        Button { text: "Elimina"; clicked => { root.delete-preset(p.id); } }
                                    }
                                }
                            }
                            VerticalBox {
                                width: 180px; spacing: 6px;
                                Button { text: "Salva «Custom»"; clicked => { root.save-preset("Custom"); } }
                                Button { text: "Salva «Session»"; clicked => { root.save-preset("Session"); } }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 72px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2a2b2f;
                    background: #1a1b1e;
                    opacity: root.sonar-enabled ? 1.0 : 0.45;
                    VerticalBox {
                        padding: 10px 16px;
                        spacing: 4px;
                        HorizontalBox {
                            Text { text: "CHATMIX"; color: #8b8d91; font-size: 11px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.chatmix-balance;
                                color: #ffffff; font-size: 11px; font-family: "monospace";
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Game"; color: #00e7a0; font-size: 11px; vertical-alignment: center; }
                            Slider {
                                horizontal-stretch: 1; minimum: -100; maximum: 100;
                                value: root.chatmix-balance;
                                enabled: root.sonar-enabled;
                                changed(v) => { root.set-chatmix(v); }
                            }
                            Text { text: "Chat"; color: #3b9eff; font-size: 11px; vertical-alignment: center; }
                        }
                        HorizontalBox {
                            Text { text: "Game " + root.game-volume + "%"; color: #8b8d91; font-size: 10px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "Chat " + root.chat-volume + "%"; color: #8b8d91; font-size: 10px; }
                        }
                    }
                }
            }
        }
    }
}
