# GearCraft – udev rules for gaming peripherals
# Install: sudo cp assets/udev/99-gearcraft.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
#
# SteelSeries vendor ID: 0x1038
# Grants read/write on hidraw to users in the "plugdev" group (or via uaccess/TAG).

# SteelSeries (all products under VID 1038)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb",    ATTRS{idVendor}=="1038", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Optional: other brands can be added later
# Razer  0x1532
# SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", MODE="0660", GROUP="plugdev", TAG+="uaccess"
# Logitech 0x046d
# SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Virtual keyboard for macros (optional)
KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
