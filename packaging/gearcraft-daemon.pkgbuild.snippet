# Snippet for an AUR PKGBUILD (gearcraft-daemon)
# Maintainer: GearCraft Contributors

pkgname=gearcraft-daemon
pkgver=0.1.0
pkgrel=1
pkgdesc="Open-source multi-brand peripheral daemon (SteelSeries GG alternative)"
arch=('x86_64')
url="https://github.com/gearcraft/gearcraft"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'systemd-libs')
optdepends=('hidapi: live USB support')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "gearcraft-$pkgver"
  cargo build --release -p gearcraft-daemon
}

package() {
  cd "gearcraft-$pkgver"
  install -Dm755 target/release/gearcraft-daemon "$pkgdir/usr/bin/gearcraft-daemon"
  install -Dm644 assets/udev/99-gearcraft.rules "$pkgdir/usr/lib/udev/rules.d/99-gearcraft.rules"
  install -Dm644 packaging/gearcraft-daemon.service "$pkgdir/usr/lib/systemd/system/gearcraft-daemon.service"
}
